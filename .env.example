# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
#
# Staging vs Production: this project uses two separate Supabase projects.
# Point .env.local at the STAGING project's keys during development —
# never develop directly against the production database.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
# The service role key bypasses Row Level Security entirely — server-only,
# never prefix it with NEXT_PUBLIC_, never send it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Zoho SMTP, per-product sender identities) ────────────────────
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
CONNECT_EMAIL_FROM=
CONNECT_EMAIL_PASSWORD=
DISCIPLESHIP_EMAIL_FROM=
DISCIPLESHIP_EMAIL_PASSWORD=

# ── SMS (BongaSMS gateway) ────────────────────────────────────────────────
BONGA_CLIENT_ID=
BONGA_KEY=
BONGA_SECRET=
BONGA_SERVICE_ID=

# ── Livestreaming (LiveKit) ───────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ── AI ("Ask Ruach" feature, Groq) ────────────────────────────────────────
GROQ_API_KEY=

# ── Media storage (Cloudflare R2) ─────────────────────────────────────────
# Only the public read URL is currently wired up. Upload credentials
# (access key/secret/endpoint/bucket) are NOT yet used anywhere in the
# code despite @aws-sdk/client-s3 being a dependency — see AUDIT_REPORT.md.
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── App config ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── One-time setup / diagnostics ──────────────────────────────────────────
# Guards pages/api/setup/*. Required in every environment — those routes
# refuse all requests if this is unset. Rotate after any use; delete the
# routes entirely once no longer needed (see AUDIT_REPORT.md P0 finding #1).
SETUP_SECRET=
